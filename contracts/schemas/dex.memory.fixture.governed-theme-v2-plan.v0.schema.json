  "title": "dex.memory.fixture.governed-theme-v2-plan.v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "operation",
    "profile",
    "disposable_runs_only",
    "theme",
    "target_layer"
  ],
  "properties": {
    "contract": { "const": "dex.memory.fixture.governed-theme-v2-plan.v0" },
    "operation": { "const": "create" },
    "profile": { "const": "governed-theme-v2" },
