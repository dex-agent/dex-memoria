{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dex-agent.github.io/dex-memoria/contracts/schemas/dex.memory.remember.request.v2.schema.json",
  "title": "dex.memory.remember.request.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["scope", "title", "trigger", "body", "tags"],
  "properties": {
    "contract": { "const": "dex.memory.remember.request.v2" },
    "scope": { "enum": ["project", "global", "theme", "dual"] },
    "target_layer": { "enum": ["L2", "L3"], "default": "L2" },
    "title": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^(?=.*\\S)[^\\r\\n\\u0000]+$" },
    "trigger": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?=.*\\S)[^\\r\\n\\u0000]+$" },
    "body": { "type": "string", "minLength": 1, "maxLength": 65536, "pattern": "\\S" },
    "tags": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^#[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)+$" } },
    "theme": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "owner_skill": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9]+(?:(?:-|:)[a-z0-9]+)*$" },
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "not": { "enum": ["lembranca", "memoria", "memorias", "conhecimento", "index", "readme", "referencias", "artefatos", "con", "prn", "aux", "nul", "com1", "com2", "com3", "com4", "com5", "com6", "com7", "com8", "com9", "lpt1", "lpt2", "lpt3", "lpt4", "lpt5", "lpt6", "lpt7", "lpt8", "lpt9"] }
    },
    "operation_id": { "type": "string", "minLength": 1, "maxLength": 256 }
  },
  "allOf": [
    { "if": { "properties": { "scope": { "const": "theme" } }, "required": ["scope"] }, "then": { "required": ["theme"] }, "else": { "not": { "required": ["theme"] } } },
    { "if": { "properties": { "target_layer": { "const": "L3" } }, "required": ["target_layer"] }, "then": { "required": ["owner_skill"] }, "else": { "not": { "required": ["owner_skill"] } } }
  ]
}
