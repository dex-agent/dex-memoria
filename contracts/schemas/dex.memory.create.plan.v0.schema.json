{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dex-agent.github.io/dex-memoria/contracts/schemas/dex.memory.create.plan.v0.schema.json",
  "title": "dex.memory.create.plan.v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "operation",
    "idempotency_key",
    "request_fingerprint",
    "transaction_id",
    "targets",
    "plan_hash"
  ],
  "properties": {
    "contract": {
      "const": "dex.memory.create.plan.v0"
    },
    "operation": {
      "const": "create"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "\\S"
    },
    "request_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "transaction_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{24}$"
    },
    "targets": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "slot",
            "relative_path",
            "before_exists",
            "before_sha256",
            "before_base64",
            "after_sha256",
            "after_base64",
            "changed"
          ],
          "properties": {
            "slot": {
              "const": "l1"
            },
            "relative_path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "\\S"
            },
            "before_exists": {
              "type": "boolean"
            },
            "before_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "before_base64": {
              "type": "string",
              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
            },
            "after_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "after_base64": {
              "type": "string",
              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
            },
            "changed": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "slot",
            "relative_path",
            "before_exists",
            "before_sha256",
            "before_base64",
            "after_sha256",
            "after_base64",
            "changed"
          ],
          "properties": {
            "slot": {
              "const": "l2"
            },
            "relative_path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "\\S"
            },
            "before_exists": {
              "type": "boolean"
            },
            "before_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "before_base64": {
              "type": "string",
              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
            },
            "after_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "after_base64": {
              "type": "string",
              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
            },
            "changed": {
              "type": "boolean"
            }
          }
        }
      ],
      "items": false
    },
    "plan_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
