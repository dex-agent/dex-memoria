{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dex-agent.github.io/dex-memoria/contracts/schemas/dex.memory.operation.receipt.v2.schema.json",
  "title": "dex.memory.operation.receipt.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "implementation_version",
    "requested_scope",
    "operation_id",
    "status",
    "recovery_mode",
    "routes",
    "route_receipts"
  ],
  "properties": {
    "contract": { "const": "dex.memory.operation.receipt.v2" },
    "implementation_version": { "const": "v2" },
    "compatibility_profile": { "enum": ["v2", "legacy-v1", "governed-theme-v2"] },
    "requested_scope": { "enum": ["project", "global", "theme", "dual"] },
    "operation_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["COMMITTED", "PARTIAL_PENDING", "FAILED"] },
    "recovery_mode": { "type": ["string", "null"], "enum": ["resume_pending_sibling", null] },
    "routes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": { "$ref": "dex.memory.operation.plan.v2.schema.json#/$defs/route" }
    },
    "route_receipts": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 2,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scope", "resolved_root", "operation_id", "idempotency_key", "transaction_id", "receipt_id", "status"],
        "properties": {
          "scope": { "enum": ["project", "global", "theme"] },
          "resolved_root": { "type": "string", "minLength": 1 },
          "operation_id": { "type": "string", "minLength": 1 },
          "idempotency_key": { "type": "string", "minLength": 1 },
          "transaction_id": { "type": "string", "minLength": 1 },
          "receipt_id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["COMMITTED", "PENDING"] },
          "receipt_path": { "type": "string" },
          "write_set_hash": { "type": "string" },
          "validation_receipt_path": { "type": "string" },
          "validation_receipt_hash": { "type": "string" },
          "validation_contract": { "const": "dex.memory.capability.unit-receipt.v2" },
          "validation_ok": { "const": true },
          "candidate_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "route_identity": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "deduplicated": { "type": "boolean" },
          "receipt_revision": { "const": 2 },
          "producer_provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["entrypoint_realpath", "entrypoint_sha256"],
            "properties": {
              "entrypoint_realpath": { "type": "string", "minLength": 1 },
              "entrypoint_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          },
          "failure_code": { "type": "string" },
          "failure_cause": { "type": "string" }
        },
        "allOf": [
          {
            "if": { "properties": { "status": { "const": "PENDING" } }, "required": ["status"] },
            "then": {
              "not": {
                "anyOf": [
                  { "required": ["receipt_revision"] },
                  { "required": ["producer_provenance"] }
                ]
              }
            }
          },
          {
            "if": { "properties": { "status": { "const": "COMMITTED" } }, "required": ["status"] },
            "then": {
              "required": [
                "receipt_path",
                "write_set_hash",
                "validation_receipt_path",
                "validation_receipt_hash",
                "validation_contract",
                "validation_ok",
                "candidate_id",
                "content_hash",
                "route_identity",
                "deduplicated"
              ],
              "oneOf": [
                {
                  "not": {
                    "anyOf": [
                      { "required": ["receipt_revision"] },
                      { "required": ["producer_provenance"] }
                    ]
                  }
                },
                { "required": ["receipt_revision", "producer_provenance"] }
              ]
            }
          }
        ]
      }
    }
  }
}
