#!/usr/bin/env bash
# pre-merge-commit — gate merge-check três vias (casa Dex; fork >= 2.4.0+dex.1)
# Padrão da casa: hook commitado + core.hooksPath (este diretório também serve
# o pre-commit do playbook — NÃO remover hooks irmãos).
# Escapes: MERGE_CHECK_SKIP=1 ou git merge --no-verify.
#
# Ciclo de vida REAL medido no Git 2.45.1 (lab 2026-11-21, issue #28): este hook
# roda ANTES de MERGE_HEAD existir no merge automático (argv vazio; o worktree já
# contém o resultado do merge). MERGE_HEAD presente aqui é contexto exótico
# (ex.: merge --no-commit). Resolução manual de conflito dispara o pre-commit
# (irmão), não este hook — a suíte desse fluxo mora lá.
set -u

GIT_DIR="${GIT_DIR:-.git}"
CONF="$(dirname "$0")/merge-check.conf"
SUITE=""
if [ -f "$CONF" ]; then . "$CONF"; fi
SUITE="${SUITE:-}"

# a. Escape declarado.
if [ "${MERGE_CHECK_SKIP:-0}" = "1" ]; then
  echo "merge-check gate: MERGE_CHECK_SKIP=1 — pulando por escape declarado."
  exit 0
fi

# b. Sem suíte declarada → avisa e NÃO bloqueia (falta de suíte não é veredito).
if [ -z "$SUITE" ]; then
  echo "merge-check gate: sem suíte declarada em $CONF — camada comportamental ausente (não bloqueia). Pendência: declarar a suíte mínima do repo."
  exit 0
fi

# c. Merge automático real (MERGE_HEAD ausente no momento do hook — medido):
#    o worktree já contém o resultado do merge → suíte direto no worktree.
if [ ! -f "$GIT_DIR/MERGE_HEAD" ]; then
  echo "merge-check gate: merge automático (MERGE_HEAD ausente no hook) — suíte no worktree do resultado."
  sh -c "$SUITE"; rc=$?
  if [ "$rc" != "0" ]; then
    echo "merge-check gate: REPROVADO (suíte falhou no worktree do merge automático, exit $rc)." >&2
    echo "  O commit de merge NÃO nasceu. Inspecione fora do hook: rode a suíte ($SUITE) no worktree." >&2
    exit 1
  fi
  exit 0
fi

# d. MERGE_HEAD presente → gate completo três vias (textual + semântico + suíte).
OURS=$(git rev-parse HEAD) || exit 1
THEIRS=$(git rev-parse MERGE_HEAD) || exit 1
BASE=$(git merge-base HEAD MERGE_HEAD) || exit 1

code-review-graph merge-check --repo . \
  --base "$BASE" --ours "$OURS" --theirs "$THEIRS" \
  --test-failure-exit 1 -- $SUITE
status=$?
if [ "$status" = "2" ]; then
  # execution_error: suíte doente não é veredito de integração — reporta, não bloqueia.
  echo "merge-check gate: execution_error (exit 2) — reportando sem bloquear."
  exit 0
fi
if [ "$status" != "0" ]; then
  echo "merge-check gate: REPROVADO (exit $status) — conflito textual/semântico ou suíte falhou no laboratório três vias." >&2
  echo "  O commit de merge NÃO nasceu. Inspecione fora do hook:" >&2
  echo "  code-review-graph merge-check --repo . --base $BASE --ours $OURS --theirs $THEIRS --test-failure-exit 1 -- $SUITE" >&2
  exit 1
fi
exit 0
